PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
API_DOMAIN=api.your-domain.example
STEAM_API_KEY=replace_with_your_steam_web_api_key
